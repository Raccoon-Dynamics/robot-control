# Secrets
.env

# ROS 2 / colcon (generated per board — never commit)
build/
install/
log/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.pytest_cache/

# Virtualenvs (ROS uses system Python; ignore if one ever appears)
.venv/
venv/
env/

# Editor / OS
.vscode/
.idea/
*.swp
*~
.DS_Store

# ---------------------------------------------------------------------------
# Preserved from the previous ROS 1 / catkin .gitignore. Kept so nothing that
# was ignored before starts showing up; prune once ROS 1 is fully gone.
# ---------------------------------------------------------------------------
devel/
logs/
bin/
lib/
msg_gen/
srv_gen/
msg/*Action.msg
msg/*ActionFeedback.msg
msg/*ActionGoal.msg
msg/*ActionResult.msg
msg/*Feedback.msg
msg/*Goal.msg
msg/*Result.msg
msg/_*.py
build_isolated/
devel_isolated/

# Generated by dynamic reconfigure
*.cfgc
/cfg/cpp/
/cfg/*.py

# Ignore generated docs
*.dox
*.wikidoc

# eclipse stuff
.project
.cproject

# qcreator stuff
CMakeLists.txt.user

srv/_*.py
*.pcd
qtcreator-*
*.user

/planning/cfg
/planning/docs
/planning/src

# Emacs
.#*

# Catkin custom files
CATKIN_IGNORE

# Colcon packages
**/COLCON_IGNORE

