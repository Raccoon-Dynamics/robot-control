<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>raccoon_interfaces</name>
  <version>0.0.0</version>
  <description>
    Shared DDS message/service definitions for the Raccoon robot.
    MUST build on BOTH boards (Pi 4B and Jetson Orin Nano) — every other package
    that talks across the network depends on the types generated here.
  </description>
  <maintainer email="reachadamzhang@gmail.com">Adam Zhang</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <!-- Types referenced from msg/*.msg -->
  <depend>builtin_interfaces</depend>
  <depend>std_msgs</depend>

  <exec_depend>rosidl_default_runtime</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
