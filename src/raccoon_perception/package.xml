<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>raccoon_perception</name>
  <version>0.0.0</version>
  <description>
    OAK-D Lite perception for the Jetson Orin Nano. Currently a placeholder that
    subscribes to the camera image stream and logs.
    BUILT ON THE JETSON ONLY.
  </description>
  <maintainer email="reachadamzhang@gmail.com">Adam Zhang</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>depthai_ros_driver</exec_depend>
  <exec_depend>image_transport</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <!--
    TODO: depthai_ros_driver has no rosdep key on arm64/Jetson in some setups.
          If `rosdep install` cannot resolve it, build depthai-ros from source
          into this workspace (or apt install ros-humble-depthai-ros) and add a
          COLCON_IGNORE-free source checkout under ./src/.
    TODO: add raccoon_interfaces here once this node publishes a Heartbeat too.
  -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
